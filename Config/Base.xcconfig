MIRROR_BUNDLE_ID = com.alperbicer.carmirror
MIRROR_DISPLAY_NAME = Mirivo
APP_GROUP_IDENTIFIER = group.$(MIRROR_BUNDLE_ID)
CODE_SIGN_STYLE = Automatic
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
IPHONEOS_DEPLOYMENT_TARGET = 18.0
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 8
ENABLE_USER_SCRIPT_SANDBOXING = YES
MIRIVO_PRO_SALES_ENABLED = YES
// Public Apple SDK key only; populated after owner approves RevenueCat credentials.
MIRIVO_REVENUECAT_API_KEY =
// Firebase is inactive until Config/GoogleService-Info.plist is supplied.
MIRIVO_APP_STORE_ID = 6818560405
// topic = free public announcements; registry = optional deployed Functions backend.
MIRIVO_NOTIFICATION_REGISTRATION_MODE = topic
MIRIVO_FIREBASE_FUNCTIONS_REGION = europe-west1
MIRIVO_FIREBASE_APPCHECK_DEBUG_ENABLED = NO
#include? "Local.xcconfig"
